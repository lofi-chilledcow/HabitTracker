# ─── Database ────────────────────────────────────────────────────────────────
# SQL Server database name. Local development uses HabitTracker_Dev.
# Production deploy should set this to the production database, for example HabitTracker_Prod.
HABITTRACKER_DB_NAME=HabitTracker_Dev

# SQL Server password for the selected database.
# Used by: AuthService, HabitService
HABITTRACKER_DB_PASSWORD=your_password_here

# ─── AuthService ─────────────────────────────────────────────────────────────
# JWT signing secret — must be at least 32 characters
# Used by: AuthService
HABITTRACKER_JWT_SECRET=your_32_character_minimum_secret_here
